{
	"schemaVersion": 1,
	"id": "superstack",
	"version": "${version}",
	"name": "superstack",
	"description": "Reduces lag and cleans up loot by visually stacking nearby items with magnetic animations!",
	"authors": [
		"SHOOOOOPz"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/FabricMC/fabric-example-mod"
	},
	"license": "CC0-1.0",
	"icon": "assets/superstack/icon.jpg",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.shooooopz.Superstack"
		],
		"client": [
			"com.shooooopz.SuperstackClient"
		]
	},
	"mixins": [
		"superstack.mixins.json",
		{
			"config": "superstack.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.18.4",
		"minecraft": "~1.21.10",
		"java": ">=21",
		"fabric-api": "*"
	}
}